# Copia este ficheiro para .env e preenche os valores para desenvolvimento local
# Em produção (Render), estas variáveis vêm do render.yaml e do dashboard

# Ligação à base de dados PostgreSQL
DATABASE_URL=postgres://cosmos:password@localhost:5432/cosmos

# Ambiente: "development" (local) ou "production" (Render)
NODE_ENV=development

# Porta local (Render define automaticamente em produção)
PORT=3000

# URL do frontend para CORS (para produção, ex: https://cosmos.onrender.com)
FRONTEND_ORIGIN=http://localhost:8000
